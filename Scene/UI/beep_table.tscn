[node name="Note" type="Label" parent="Panel/Box"]
layout_mode = 2
theme_override_colors/font_color = Color(0.4, 0.3, 0.2, 1)
theme_override_font_sizes/font_size = 15
text = "เปิดเครื่องแล้วลำโพงบนเมนบอร์ดร้อง = BIOS บอกว่าชิ้นไหนมีปัญหา · ● = สั้น  ▬ = ยาว · กด ▶ เพื่อฟัง
รหัสต่างกันนิดหน่อยตามยี่ห้อ BIOS (ตารางนี้ยึด AMI เป็นหลัก) — งานจริงให้ดูคู่มือเมนบอร์ดรุ่นนั้นด้วย"
