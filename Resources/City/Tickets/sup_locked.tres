[gd_resource type="Resource" script_class="OfficeTicket" format=3]

[ext_resource type="Script" path="res://Scripts/Resources/office_ticket.gd" id="1"]

[resource]
script = ExtResource("1")
id = &"sup_locked"
category = 2
title = "ล็อกอินไม่ได้ทั้งที่รหัสถูก"
from = "ฝ่ายจัดซื้อ"
ask = "หนูใส่รหัสถูกแน่ ๆ แต่ระบบบอกบัญชีถูกล็อก"
actions = PackedStringArray("ดูสถานะบัญชี", "ถามผู้ใช้")
results = PackedStringArray("> ระบบบัญชีผู้ใช้
Locked : ใส่รหัสผิด 5 ครั้ง
จาก : โทรศัพท์มือถือ (อีเมล)", "> คุยกับผู้ใช้
เมื่อวานเพิ่งเปลี่ยนรหัสใหม่
มือถือยังตั้งรหัสเก่าไว้ในแอปอีเมล")
question = "จะแก้ยังไง"
choices = PackedStringArray("ยืนยันตัวตนแล้วปลดล็อก และพาเปลี่ยนรหัสในแอปอีเมลบนมือถือด้วย", "ปลดล็อกอย่างเดียวพอ", "ลบบัญชีแล้วสร้างใหม่", "บอกให้ใช้บัญชีเพื่อนไปก่อน")
explain = "มือถือที่จำรหัสเก่าจะลองล็อกอินเองซ้ำ ๆ จนบัญชีล็อก ถ้าปลดล็อกอย่างเดียวเดี๋ยวก็ล็อกอีก ต้องแก้ที่ต้นเหตุ และห้ามให้ใช้บัญชีคนอื่น"
skill = "หาต้นเหตุบัญชีล็อก"
