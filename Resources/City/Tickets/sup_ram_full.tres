script = ExtResource("1")
id = &"sup_ram_full"
category = 1
title = "เครื่องช้ามากตอนบ่าย"
from = "ฝ่ายการตลาด"
ask = "เช้า ๆ ปกติดี พอบ่ายเครื่องหน่วงจนพิมพ์งานไม่ทัน"
actions = PackedStringArray("เปิด Task Manager", "ดูพื้นที่ดิสก์", "ดูอุณหภูมิเครื่อง")
