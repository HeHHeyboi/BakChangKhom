Memory : 95% ใช้อยู่", "> This PC
C: เหลือ 120 GB จาก 237 GB", "> โปรแกรมวัดอุณหภูมิ
CPU 55°C ปกติ")
question = "จะแก้ยังไง"
choices = PackedStringArray("ปิดแท็บที่ไม่ใช้และสอนผู้ใช้ ถ้าเป็นประจำค่อยเสนอเพิ่มแรม", "เปลี่ยนซีพียูทันที", "ฟอร์แมตเครื่อง", "ลบโปรแกรมแชต")
explain = "ดูข้อมูลก่อนเดา ดิสก์กับความร้อนปกติ แต่แรมใช้ 95% เพราะแท็บเบราว์เซอร์ แก้ที่ต้นเหตุและอธิบายให้ผู้ใช้เข้าใจ จะได้ไม่เกิดซ้ำ"
skill = "Task Manager"
