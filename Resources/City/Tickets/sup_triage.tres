[gd_resource type="Resource" script_class="OfficeTicket" format=3]

[ext_resource type="Script" path="res://Scripts/Resources/office_ticket.gd" id="1"]

[resource]
script = ExtResource("1")
id = &"sup_triage"
category = 3
title = "ตั๋วเข้าพร้อมกัน 3 ใบ"
from = "ระบบแจ้งปัญหา"
ask = "เช้าวันจันทร์ ตั๋วเข้ามาพร้อมกัน ทำได้ทีละงาน"
actions = PackedStringArray("อ่านตั๋วทั้งหมด", "ดูว่าใครรอนานสุด")
results = PackedStringArray("#3101 ระบบขายเปิดไม่ได้ทั้งทีม 15 คน
#3102 เมาส์พี่บัญชีดับเบิลคลิกเอง
#3103 อยากเปลี่ยนรูปพื้นหลัง", "> เวลาแจ้ง
#3103 แจ้งก่อน 10 นาที
#3101 เพิ่งแจ้ง")
question = "ควรทำตั๋วไหนก่อน"
choices = PackedStringArray("#3101 เพราะกระทบคนมากที่สุดและงานขายหยุด", "#3103 เพราะแจ้งมาก่อน", "#3102 เพราะง่ายสุด", "ทำตามใจชอบ")
explain = "ไอทีซัพพอร์ตจัดลำดับตามผลกระทบและความเร่งด่วน ไม่ใช่ตามลำดับที่แจ้ง ระบบที่ทั้งทีมใช้ไม่ได้มาก่อน แล้วบอกคนอื่นว่าจะไปดูเมื่อไร"
skill = "จัดลำดับตั๋ว"
