[gd_resource type="Resource" script_class="OfficeTicket" format=3]

[ext_resource type="Script" path="res://Scripts/Resources/office_ticket.gd" id="1"]

[resource]
script = ExtResource("1")
id = &"sup_phish_reset"
category = 2
title = "ผู้จัดการขอรหัสใหม่ทางโทรศัพท์"
from = "สายโทรเข้า"
ask = "ผมผู้จัดการฝ่ายขายนะ ลืมรหัส ประชุมอีก 5 นาที รีเซ็ตแล้วบอกรหัสใหม่ทางโทรศัพท์เลย ด่วนมาก"
actions = PackedStringArray("ดูเบอร์ที่โทรเข้า", "ค้นรายชื่อพนักงาน")
results = PackedStringArray("> ระบบโทรศัพท์
เบอร์ 08x-xxx-4417 ไม่อยู่ในรายชื่อพนักงาน", "> ระบบพนักงาน
ผู้จัดการฝ่ายขาย : เบอร์ภายใน 1204
สถานะวันนี้ : ลาพักร้อน")
question = "จะทำยังไง"
choices = PackedStringArray("ยังไม่รีเซ็ต โทรกลับเบอร์ในระบบเพื่อยืนยันตัวตนก่อน", "รีเซ็ตแล้วบอกรหัสทันทีเพราะด่วน", "บอกรหัสเดิมให้", "ปิดบัญชีผู้จัดการถาวร")
explain = "การเร่งให้รีบเป็นกลลวงทางสังคมที่เจอบ่อย ไอทีซัพพอร์ตต้องยืนยันตัวตนทุกครั้งและไม่บอกรหัสทางโทรศัพท์ ให้ผู้ใช้ตั้งรหัสเองเท่านั้น"
skill = "ยืนยันตัวตนก่อนรีเซ็ต"
