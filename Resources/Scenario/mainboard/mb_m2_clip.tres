lines = Dictionary[String, String]({"INSPECT_FINS": "มุมหนึ่งของฮีตซิงก์ลอยขึ้นมา ขาล็อกหลุดไปข้างหนึ่ง|ฮีตซิงก์ไม่แนบกับ CPU ความร้อนเลยออกไม่หมด", "INSPECT_PASTE": "ซิลิโคนยังพอใช้ได้อยู่ แต่เกลี่ยไม่เต็มเพราะฮีตซิงก์เอียง"})
