lines = Dictionary[String, String]({"INSPECT_STANDOFF": "ข้างซ็อกเก็ตมีตัวเก็บประจุหัวโป่งขึ้นมา มีคราบสีน้ำตาลรอบ ๆ|แบบนี้คือบอร์ดเสื่อม ซ่อมต่อก็ไม่หาย"})
diag_choices = PackedStringArray("ตัวเก็บประจุบวม บอร์ดเสื่อม ต้องเปลี่ยนบอร์ด", "ปุ่มเปิดเครื่องเสีย", "ซิลิโคนแห้ง", "แรมสกปรก")
diag_wrong = "เปลี่ยนซิลิโคนแล้วอาจดีขึ้นชั่วคราว แต่ลองดูตัวเก็บประจุข้างซ็อกเก็ตก่อน"
diag_correct = "ถูก ตัวเก็บประจุบวมแบบนี้ต้องบอกลูกค้าว่าไม่คุ้มซ่อม แล้วเสนอบอร์ดมือสอง"
needs_part = &"mb_used"
part_hint = "ตัวเก็บประจุบวม ต้องเปลี่ยนเมนบอร์ด"
decoy = "เปลี่ยนซิลิโคนแล้วเปิดติด แต่อีกไม่กี่วันลูกค้าจะกลับมาเคลม"
teach = "ดูอาการเสื่อมของชิ้นส่วนด้วยตา และรู้ว่าเมื่อไรควรบอกลูกค้าว่าไม่คุ้มซ่อม"
flags = {"post": "การ์ด POST ขึ้นรหัสวนไม่ผ่านขั้นจ่ายไฟของบอร์ด"}
