[resource]
script = ExtResource("1")
id = &"quiz_booth_5"
kind = 2
group = &"booth"
question = "ลบไฟล์แล้วทำไมพื้นที่ไม่เพิ่ม"
choices = PackedStringArray("ไฟล์ยังอยู่ในถังขยะ ต้องล้างถังขยะด้วย", "ต้องซื้อเครื่องใหม่", "ต้องลบไฟล์ระบบเพิ่ม")
explain = "ไฟล์ที่ลบไปอยู่ในถังขยะก่อน ล้างถังขยะแล้วพื้นที่ถึงจะว่างจริง"
