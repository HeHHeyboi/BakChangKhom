[ext_resource type="Script" path="res://Scripts/Resources/shop_event.gd" id="1"]

[resource]
script = ExtResource("1")
id = &"quiz_kids_4"
kind = 2
group = &"kids"
question = "ทำไมต้องจับการ์ดจอที่ขอบ"
choices = PackedStringArray("กันไฟฟ้าสถิตและคราบมือโดนวงจร", "จะได้ดูเท่", "เพราะตรงกลางร้อน")
explain = "ไฟฟ้าสถิตจากมือทำให้ชิปเสียได้ จับที่ขอบและแตะโลหะเคสก่อน"
