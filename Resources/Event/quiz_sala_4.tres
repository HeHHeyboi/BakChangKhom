[resource]
script = ExtResource("1")
id = &"quiz_sala_4"
kind = 2
group = &"sala"
question = "ไฟล์ที่ดาวน์โหลดมาไปอยู่ที่ไหน"
choices = PackedStringArray("โฟลเดอร์ดาวน์โหลด", "หายไปแล้ว", "อยู่ในถังขยะ")
explain = "ไฟล์ที่ดาวน์โหลดจากเว็บจะไปอยู่ในโฟลเดอร์ดาวน์โหลดเป็นค่าเริ่มต้น"
