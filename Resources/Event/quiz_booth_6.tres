[gd_resource type="Resource" script_class="ShopEvent" format=3]

[ext_resource type="Script" path="res://Scripts/Resources/shop_event.gd" id="1"]

[resource]
script = ExtResource("1")
id = &"quiz_booth_6"
kind = 2
group = &"booth"
question = "คอมค้างกดอะไรไม่ได้เลยทำยังไงก่อน"
choices = PackedStringArray("รอสักพักแล้วเปิดตัวจัดการงานปิดโปรแกรมที่ค้าง", "ถอดปลั๊กทันที", "ทุบจอเบา ๆ")
explain = "ปิดเฉพาะโปรแกรมที่ค้างก่อน ถอดปลั๊กทันทีเสี่ยงให้ไฟล์ที่เปิดอยู่เสีย"
