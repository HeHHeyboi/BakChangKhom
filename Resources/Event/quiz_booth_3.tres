[gd_resource type="Resource" script_class="ShopEvent" format=3]

[ext_resource type="Script" path="res://Scripts/Resources/shop_event.gd" id="1"]

[resource]
script = ExtResource("1")
id = &"quiz_booth_3"
kind = 2
group = &"booth"
question = "จอคอมควรห่างจากตาเท่าไร"
choices = PackedStringArray("ประมาณหนึ่งช่วงแขนและพักสายตาบ่อย ๆ", "ใกล้ ๆ จะได้เห็นชัด", "ไกลเท่าไรก็ได้ไม่ต่างกัน")
explain = "ห่างราวหนึ่งช่วงแขนและละสายตาไปมองไกลทุกยี่สิบนาทีช่วยให้ตาไม่ล้า"
