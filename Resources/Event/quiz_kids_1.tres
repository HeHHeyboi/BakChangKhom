[gd_resource type="Resource" script_class="ShopEvent" format=3]

[ext_resource type="Script" path="res://Scripts/Resources/shop_event.gd" id="1"]

[resource]
script = ExtResource("1")
id = &"quiz_kids_1"
kind = 2
group = &"kids"
question = "พี่ขม ทำไมต้องถอดปลั๊กก่อนแกะเครื่อง"
choices = PackedStringArray("กันไฟดูดและกันชิ้นส่วนช็อตเสีย", "เครื่องจะได้เย็น", "ไม่ต้องถอดก็ได้")
explain = "ไฟยังค้างอยู่ในเครื่องได้ ถอดปลั๊กแล้วกดปุ่มเปิดค้างคายไฟก่อนแตะชิ้นส่วน"
