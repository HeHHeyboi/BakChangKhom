[gd_resource type="Resource" script_class="ShopEvent" format=3]

[ext_resource type="Script" path="res://Scripts/Resources/shop_event.gd" id="1"]

[resource]
script = ExtResource("1")
id = &"quiz_sala_1"
kind = 2
group = &"sala"
question = "ดับเบิลคลิกคืออะไร"
choices = PackedStringArray("กดปุ่มซ้ายของเมาส์สองครั้งเร็ว ๆ เพื่อเปิด", "กดปุ่มขวาสองครั้ง", "กดค้างไว้นาน ๆ")
explain = "ดับเบิลคลิกคือกดปุ่มซ้ายสองครั้งติดกันใช้เปิดไฟล์หรือโปรแกรม"
