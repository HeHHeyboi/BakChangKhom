[gd_resource type="Resource" script_class="ShopEvent" format=3]

[ext_resource type="Script" path="res://Scripts/Resources/shop_event.gd" id="1"]

[resource]
script = ExtResource("1")
id = &"quiz_sala_5"
kind = 2
group = &"sala"
question = "พิมพ์แล้วขึ้นภาษาอังกฤษแทนภาษาไทยทำยังไง"
choices = PackedStringArray("กดปุ่มตัวหนอนเพื่อสลับภาษา", "ต้องลงวินโดวส์ใหม่", "คีย์บอร์ดเสียแล้ว")
explain = "คีย์บอร์ดไทยกดปุ่มตัวหนอนมุมซ้ายบนเพื่อสลับไทยกับอังกฤษ"
