[resource]
script = ExtResource("1")
id = &"quiz_sala_3"
kind = 2
group = &"sala"
question = "ตัวหนังสือบนจอเล็กไปทำยังไง"
choices = PackedStringArray("กด Ctrl ค้างแล้วหมุนลูกกลิ้งเมาส์", "เอาแว่นขยายส่องจอ", "ต้องซื้อจอใหม่")
explain = "กด Ctrl ค้างแล้วหมุนลูกกลิ้งขยายหรือย่อตัวหนังสือได้ในเกือบทุกโปรแกรม"
