[gd_resource type="Resource" script_class="ShopEvent" format=3]

[ext_resource type="Script" path="res://Scripts/Resources/shop_event.gd" id="1"]

[resource]
script = ExtResource("1")
id = &"quiz_booth_1"
kind = 2
group = &"booth"
question = "ถอดแฟลชไดรฟ์ต้องทำอะไรก่อนไหม"
choices = PackedStringArray("กดนำอุปกรณ์ออกอย่างปลอดภัยก่อนแล้วค่อยดึง", "ดึงออกได้เลยตอนไฟกะพริบ", "ต้องปิดเครื่องทุกครั้ง")
explain = "ถ้าดึงตอนเครื่องยังเขียนไฟล์อยู่ไฟล์อาจเสีย กดนำออกอย่างปลอดภัยก่อน"
