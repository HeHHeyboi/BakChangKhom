[gd_resource type="Resource" script_class="ShopEvent" format=3]

[ext_resource type="Script" path="res://Scripts/Resources/shop_event.gd" id="1"]

[resource]
script = ExtResource("1")
id = &"quiz_booth_2"
kind = 2
group = &"booth"
question = "ทำไมพัดลมคอมดังขึ้นเรื่อย ๆ"
choices = PackedStringArray("ฝุ่นจับพัดลมกับครีบระบายความร้อน ควรทำความสะอาด", "เครื่องกำลังจะระเบิด", "ต้องเปลี่ยนเครื่องใหม่ทันที")
explain = "ฝุ่นทำให้เครื่องร้อน พัดลมต้องหมุนเร็วขึ้น ทำความสะอาดปีละครั้งช่วยได้มาก"
