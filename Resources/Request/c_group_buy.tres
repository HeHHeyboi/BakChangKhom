[gd_resource type="Resource" script_class="RequestTask" format=3]

[ext_resource type="Script" path="res://Scripts/Resources/request_task.gd" id="1"]

[resource]
script = ExtResource("1")
id = &"c_group_buy"
kind = 0
npc_tags = PackedStringArray("group")
min_rank = 1
title = "รวมเงินซื้อการ์ดจอให้แฟร์"
ask = "พวกเรารวมเงินกันได้สามพันหกร้อย บิวออกพันแปด ต้นกล้าออกพันสอง แพรวออกหกร้อย จะซื้อการ์ดจอมือสองไว้เล่นด้วยกัน"
question = "ถ้าวันหลังขายต่อได้สามพันบาท ควรแบ่งเงินกันยังไงให้แฟร์"
choices = PackedStringArray("แบ่งตามสัดส่วนที่ลงเงิน บิว 1500 ต้นกล้า 1000 แพรว 500", "แบ่งเท่ากันคนละพัน", "ให้บิวหมดเพราะลงเงินเยอะสุด")
explain = "ลงเงินไม่เท่ากันก็แบ่งตามสัดส่วนที่ลง 1800 1200 600 คิดเป็นครึ่งหนึ่ง หนึ่งในสาม และหนึ่งในหก ของสามพัน"
question2 = "ก่อนจ่ายเงินซื้อการ์ดจอมือสอง ควรทำอะไร"
choices2 = PackedStringArray("ขอดูทดสอบเล่นจริงและดูประกันที่เหลือ", "โอนเงินก่อนเพราะคนขายรีบ")
explain2 = "ของมือสองต้องเห็นทำงานจริงก่อนจ่าย ถ้าคนขายรีบให้โอนให้ระวังไว้ก่อน"
fee = 30
thanks = "แฟร์ทุกคนเลย ไม่ต้องทะเลาะกันแล้ว"
topic = "คณิตศาสตร์กับการเงิน"
# [Claude 16 พ.ย. 2569 · 0.6.0 ขั้น I] คำขอของกลุ่ม (ปรึกษาซื้อของรวมเงิน)
