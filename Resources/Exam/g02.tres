[resource]
script = ExtResource("1")
id = &"g02"
part = &"general"
level = 1
question = "ทำไมต้องแตะโลหะหรือใส่สายรัดข้อมือก่อนจับชิ้นส่วน"
choices = PackedStringArray("ปล่อยไฟฟ้าสถิตออกจากตัว", "ให้มือสะอาดขึ้น", "ให้ชิ้นส่วนเย็นลง")
answer = 0
explain = "ไฟฟ้าสถิตจากตัวเราทำให้ชิปเสียได้โดยไม่รู้ตัว"
