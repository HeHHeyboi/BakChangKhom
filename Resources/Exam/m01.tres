[gd_resource type="Resource" script_class="ExamQuestion" format=3]

[ext_resource type="Script" path="res://Scripts/Resources/exam_question.gd" id="1"]

[resource]
script = ExtResource("1")
id = &"m01"
part = &"part_mainboard"
level = 1
question = "ซิลิโคนระบายความร้อนทาไว้ระหว่างอะไรกับอะไร"
choices = PackedStringArray("ซีพียูกับฮีตซิงก์", "แรมกับเมนบอร์ด", "เคสกับพื้นโต๊ะ")
answer = 0
explain = "ซิลิโคนอุดช่องอากาศเล็ก ๆ ให้ความร้อนจากซีพียูถ่ายไปฮีตซิงก์ได้ดี"
