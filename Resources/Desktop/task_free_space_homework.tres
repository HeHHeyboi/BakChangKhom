[resource]
script = ExtResource("1_task")
goal = 2
title = "ทำที่ว่างให้โน้ตบุ๊กมิ้น"
pc_name = "โน้ตบุ๊กของมิ้น"
request = "เครื่องเต็ม เซฟรายงานกลุ่มส่งครูไม่ได้"
files = Array[ExtResource("2_file")]([SubResource("Resource_f1"), SubResource("Resource_f2"), SubResource("Resource_f3"), SubResource("Resource_f4"), SubResource("Resource_f5"), SubResource("Resource_f6"), SubResource("Resource_f7"), SubResource("Resource_f8"), SubResource("Resource_f9"), SubResource("Resource_f10")])
programs = Array[ExtResource("3_prog")]([SubResource("Resource_p1")])
disk_total_mb = 128000
disk_free_mb = 150
free_space_target_mb = 1500
traps = Array[StringName]([&"delete_system", &"delete_user", &"click_ad", &"fake_download"])
ask_options = PackedStringArray("ไฟล์ไหนที่มิ้นไม่ใช้แล้วบ้าง", "มิ้นใช้เครื่องนี้มากี่ปีแล้ว", "ขอลบทั้งโฟลเดอร์ดาวน์โหลดเลยได้ไหม")
ask_answer = "ซีรีส์ในดาวน์โหลดดูจบแล้ว ตัวติดตั้งเกมเก่าก็ไม่เล่นแล้ว แต่รายงานกลุ่มกับรูปเพื่อนห้ามหายนะ"
explain_options = PackedStringArray("ไฟล์ที่โหลดซ้ำจะมีเลขต่อท้าย ลบตัวซ้ำแล้วล้างถังขยะ พื้นที่ก็กลับมา", "ต้องซื้อฮาร์ดดิสก์เพิ่มอย่างเดียว", "ลบทุกอย่างในดาวน์โหลดทิ้งเป็นประจำก็พอ")
pib_intro = PackedStringArray("เครื่องเต็ม ต้องหาไฟล์ที่ซ้ำกันแล้วลบออก", "ไฟล์ที่ชื่อมีคำว่าสำเนา ลองเปิดดูก่อนว่าซ้ำจริงไหม ของลูกค้าห้ามลบเด็ดขาด", "ลบแล้วไฟล์ยังอยู่ในถังขยะนะ ต้องล้างถังขยะพื้นที่ถึงจะคืน")
pib_lesson = PackedStringArray("ลบไฟล์ให้ถามเจ้าของก่อนทุกครั้ง ไฟล์ระบบห้ามแตะ", "และจำไว้ว่าลบแล้วต้องล้างถังขยะ พื้นที่ถึงจะกลับมาจริง")
