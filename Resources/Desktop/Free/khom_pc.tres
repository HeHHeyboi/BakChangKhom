disk_free_mb = 120000
traps = Array[StringName]([])
ask_options = PackedStringArray("-", "-")
explain_options = PackedStringArray("-", "-")
pib_intro = PackedStringArray("นี่คอมของขมเอง ใช้ได้ตามสบายเลยนะ", "ลองฝึกเปิดไฟล์ ลบไฟล์ ถอนโปรแกรมไว้ เวลาลูกค้ามาจะได้คล่อง ปิดเครื่องได้ที่ปุ่มเริ่ม")
pib_lesson = PackedStringArray()
