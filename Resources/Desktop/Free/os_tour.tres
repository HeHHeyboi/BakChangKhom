explain_options = PackedStringArray("-", "-")
pib_intro = PackedStringArray("เปิดติดแล้ว! นี่คือขมOS ระบบปฏิบัติการของเครื่อง เป็นตัวกลางให้เราสั่งงานคอมได้", "ทำตามโน้ตสีเหลืองทีละข้อนะ ปิ๊บจะชี้ให้ว่าต้องกดตรงไหน")
pib_lesson = PackedStringArray()
