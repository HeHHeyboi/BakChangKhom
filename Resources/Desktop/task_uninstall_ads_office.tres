[resource]
script = ExtResource("1_task")
goal = 1
title = "ถอนโปรแกรมโฆษณาห้องธุรการ"
pc_name = "คอมห้องธุรการโรงเรียน"
request = "ประชุมออนไลน์ทีไร โฆษณาเด้งขึ้นจอให้อายครู"
files = Array[ExtResource("2_file")]([SubResource("Resource_f1"), SubResource("Resource_f2"), SubResource("Resource_f3"), SubResource("Resource_f4"), SubResource("Resource_f5")])
programs = Array[ExtResource("3_prog")]([SubResource("Resource_p1"), SubResource("Resource_p2"), SubResource("Resource_p3"), SubResource("Resource_p4"), SubResource("Resource_p5")])
disk_free_mb = 30000
traps = Array[StringName]([&"icon_only", &"delete_system", &"click_ad", &"fake_download", &"delete_user"])
ask_options = PackedStringArray("โฆษณาเริ่มเด้งหลังลงโปรแกรมอะไรครับ", "ประชุมออนไลน์บ่อยแค่ไหนครับ", "ห้องนี้เปิดแอร์ทั้งวันไหมครับ")
ask_answer = "ครูธุรการลงตัวแปลงไฟล์ฟรีมา หลังจากนั้นก็มีหน้าค้นหาแปลก ๆ กับโฆษณาลดราคาขึ้นมาเลย"
explain_options = PackedStringArray("ตัวติดตั้งฟรีบางตัวแถมโปรแกรมโฆษณามา ถอนในหน้าตั้งค่าให้ครบทุกตัว และติดตั้งอะไรให้อ่านทุกหน้าก่อน", "ปิดเครื่องแล้วเปิดใหม่ก็หายเอง", "ซื้อโปรแกรมกันไวรัสแพง ๆ มาลง")
pib_intro = PackedStringArray("โฆษณาเด้งแบบนี้ เพราะมีโปรแกรมโฆษณาแอบติดอยู่ในเครื่อง", "ลบแค่ไอคอนไม่พอนะ ต้องถอนการติดตั้งในหน้าตั้งค่า แล้วหน้าต่างโฆษณาให้กดกากบาทปิด อย่ากดข้างใน", "เครื่องนี้อาจมีมากกว่าหนึ่งตัวนะ ดูในรายการแอปให้ครบ")
pib_lesson = PackedStringArray("ถอนโปรแกรมต้องทำผ่านหน้าตั้งค่า ไอคอนเป็นแค่ทางลัดเท่านั้น", "ของระบบอย่าถอน ถอนเฉพาะตัวที่รู้แน่ว่าเป็นโฆษณา")
