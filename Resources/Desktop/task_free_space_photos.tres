"size_mb": 1200,
"folder": "รูปภาพ",
"kind": "dup",
"dup_of": "รูปงานบวช"
}, {
"name": "รูปงานบวช.zip",
"size_mb": 1100,
"folder": "ดาวน์โหลด",
"kind": "dup",
"dup_of": "รูปงานบวช",
"note": "ไฟล์บีบอัดของรูปงานบวช ข้างในเหมือนตัวจริงทุกรูป"
}, {
