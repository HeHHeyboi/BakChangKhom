"size_mb": 5,
"folder": "เดสก์ท็อป",
"kind": "user",
"note": "รูปที่ลุงชอบที่สุด"
}, {
"name": "บัญชีสวนยาง.doc",
"size_mb": 2,
"folder": "เอกสาร",
"kind": "user",
"note": "บัญชีรายรับสวนยางทั้งปี"
}, {
"name": "ขมOS",
"size_mb": 20000,
"folder": "ระบบ (C:)",
