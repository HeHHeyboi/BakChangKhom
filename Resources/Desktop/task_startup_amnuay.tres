[resource]
script = ExtResource("1_task")
goal = 8
title = "ทำให้เปิดเครื่องเร็วขึ้น"
pc_name = "คอมพิวเตอร์ของลุงอำนวย"
request = "กดเปิดเครื่องแล้วรอเป็นนาที กว่าจะใช้ได้"
files = Array[ExtResource("2_file")]([SubResource("Resource_f1"), SubResource("Resource_f2"), SubResource("Resource_f3")])
programs = Array[ExtResource("3_prog")]([SubResource("Resource_p1"), SubResource("Resource_p2"), SubResource("Resource_p3")])
disk_free_mb = 20000
browser_ad = false
ask_note = "ลุงไม่ใช้: เกมฟาร์ม · แชตเก่า · เครื่องพิมพ์"
processes = Array[ExtResource("4_proc")]([SubResource("Resource_x1"), SubResource("Resource_x2"), SubResource("Resource_x3"), SubResource("Resource_x4"), SubResource("Resource_x5")])
boot_target_s = 16
traps = Array[StringName]([&"disable_system", &"kill_system", &"delete_system", &"delete_user"])
ask_options = PackedStringArray("เปิดเครื่องแล้วมีโปรแกรมอะไรเด้งขึ้นมาเองบ้างครับ", "ลุงปลูกผักอะไรบ้างครับ", "ซื้อแรมเพิ่มไหมครับ")
ask_answer = "ขึ้นเกมฟาร์มผักของหลาน โปรแกรมแชตเก่า แล้วก็อะไรเครื่องพิมพ์ไม่รู้ ลุงไม่ได้ใช้สักอัน"
explain_options = PackedStringArray("ปิดโปรแกรมที่ไม่ใช้ไม่ให้เปิดพร้อมเครื่อง โปรแกรมยังอยู่ อยากใช้ก็กดเปิดเอง แอนตี้ไวรัสยังเปิดไว้เหมือนเดิม", "ลบโปรแกรมทิ้งหมดแล้วครับ", "ปิดแอนตี้ไวรัสด้วยจะได้เร็วขึ้น")
pib_intro = PackedStringArray("เปิดเครื่องช้าเพราะโปรแกรมแย่งกันเปิดพร้อมเครื่อง เปิดตัวจัดการงาน แล้วไปแท็บเปิดพร้อมเครื่อง", "ปิดเฉพาะตัวที่ลูกค้าไม่ใช้ แอนตี้ไวรัสกับของระบบต้องเปิดไว้")
pib_lesson = PackedStringArray("ปิดเปิดพร้อมเครื่อง ไม่ใช่การลบโปรแกรม", "ของระบบกับแอนตี้ไวรัสต้องเปิดพร้อมเครื่องเสมอ")
