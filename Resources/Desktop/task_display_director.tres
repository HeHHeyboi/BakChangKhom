[resource]
script = ExtResource("1_task")
goal = 11
title = "แก้จอแตก ตัวหนังสือใหญ่"
pc_name = "คอมห้องพักครู"
request = "จอดูแตก ๆ ตัวหนังสือใหญ่จนล้นจอ เปิดเอกสารดูไม่ครบ"
files = Array[ExtResource("2_file")]([SubResource("Resource_f1"), SubResource("Resource_f2"), SubResource("Resource_f3")])
programs = Array[ExtResource("3_prog")]([SubResource("Resource_p1")])
disk_free_mb = 20000
browser_ad = false
ask_note = "ย้ายจอ + มีคนกดตั้งค่ามั่ว"
resolutions = Array[ExtResource("4_res")]([SubResource("Resource_d1"), SubResource("Resource_d2"), SubResource("Resource_d3")])
display_scale = 150
traps = Array[StringName]([&"bad_resolution", &"delete_system", &"delete_user"])
ask_options = PackedStringArray("จอเริ่มเป็นแบบนี้ตั้งแต่เมื่อไหร่ครับ", "โรงเรียนมีนักเรียนกี่คนครับ", "ใช้คอมทำอะไรบ่อยสุดครับ")
ask_answer = "ตั้งแต่ภารโรงย้ายจอมาใหม่ แล้วลองกดตั้งค่าอะไรไปก็ไม่รู้"
explain_options = PackedStringArray("ตั้งความละเอียดกลับเป็นค่าที่แนะนำ และขนาดตัวหนังสือ 100% จอจะคมและพอดี ถ้าเลือกแล้วจอดำให้กดคืนค่าเดิม", "จอเสีย ต้องซื้อใหม่ครับ", "ตั้งความละเอียดสูงสุดไว้จะคมที่สุด")
pib_intro = PackedStringArray("จอแตกตัวใหญ่ส่วนมากเพราะความละเอียดไม่ตรงจอ ไปที่ตั้งค่า แล้วกดจอภาพ", "เลือกอันที่เขียนว่าแนะนำ ถ้าเลือกแล้วจอดำ ให้กดคืนค่าเดิม")
pib_lesson = PackedStringArray("ความละเอียดที่แนะนำคือค่าที่ตรงกับจอ คมที่สุด", "ค่าสูงเกินที่จอรองรับ จอจะดำ")
