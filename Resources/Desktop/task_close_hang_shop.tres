[resource]
script = ExtResource("1_task")
goal = 3
title = "ปิดโปรแกรมคิดเงินที่ค้าง"
pc_name = "คอมพิวเตอร์ร้านชำ"
request = "โปรแกรมคิดเงินค้าง กดอะไรก็ไม่ขยับ ลูกค้ารอจ่ายเงินอยู่"
files = Array[ExtResource("2_file")]([SubResource("Resource_f1"), SubResource("Resource_f2"), SubResource("Resource_f3")])
programs = Array[ExtResource("3_prog")]([SubResource("Resource_p1"), SubResource("Resource_p2")])
disk_free_mb = 20000
browser_ad = false
ask_note = "ตารางบัญชี ยังไม่บันทึก อย่าปิด!"
processes = Array[ExtResource("4_proc")]([SubResource("Resource_x1"), SubResource("Resource_x2"), SubResource("Resource_x3"), SubResource("Resource_x4")])
traps = Array[StringName]([&"kill_system", &"kill_unsaved", &"delete_system", &"delete_user"])
ask_options = PackedStringArray("ตอนนี้มีงานอะไรเปิดค้างไว้อีกไหมครับ", "ซื้อเครื่องนี้มากี่ปีแล้วครับ", "ลองถอดปลั๊กหรือยังครับ")
ask_answer = "มีตารางบัญชีที่แม่พิมพ์ค้างไว้ ยังไม่ได้กดบันทึกเลย อันนั้นอย่าปิดนะ"
explain_options = PackedStringArray("โปรแกรมค้างให้เปิดตัวจัดการงาน (Ctrl+Shift+Esc) แล้วกดจบงานเฉพาะตัวที่ไม่ตอบสนอง งานอื่นยังอยู่ครบ", "ค้างเมื่อไหร่ถอดปลั๊กเลย เร็วสุด", "ลงโปรแกรมคิดเงินใหม่ทุกครั้งที่ค้าง")
pib_intro = PackedStringArray("โปรแกรมค้างกดกากบาทไม่ได้ ต้องใช้ตัวจัดการงาน กด Ctrl+Shift+Esc หรือปุ่มเริ่ม แล้วเลือกตัวจัดการงาน", "จบงานเฉพาะตัวที่ขึ้นว่าไม่ตอบสนองนะ ของระบบกับงานที่ลูกค้ายังไม่บันทึกอย่าไปปิด")
pib_lesson = PackedStringArray("ตัวจัดการงานปิดได้ทีละโปรแกรม ไม่ต้องดับทั้งเครื่อง", "ดูสถานะกับประเภทก่อนกดจบงานเสมอ")
